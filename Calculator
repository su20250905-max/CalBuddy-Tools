// function append Operator
function appendOperator(operator) {
    const lastChar = inputLine.value.slice(-1);
    if ('+-*/^'.includes(lastChar)) {
        inputLine.value = inputLine.value.slice(0, -1) + operator;
    } else if (inputLine.value !== '') {
        inputLine.value += operator;
    }
    inputLine.focus();
}
// function append function
function appendFunction(func) {
    inputLine.value += func;
    inputLine.focus();
}
// function to Radians
function toRadians(deg) {
    return deg * Math.PI / 180;
}
// function append Pi
function appendPi() {
    const input = document.getElementById('inputLine');
    const lastChar = input.value.slice(-1);
    if (/\d|\)/.test(lastChar)) {
        input.value += '*' + Math.PI;
    } else {
        input.value += Math.PI;
    }
}
// function factorial
function factorial() {
    const input = document.getElementById('inputLine');
    try {
        let n = eval(input.value);
        if (!Number.isInteger(n) || n < 0) {
            resultLine.textContent = 'Error';
            return;
        }
        let res = 1;
        for (let i = 2; i <= n; i++) {
            res *= i;
        }
        input.value = res;
        input.focus();
    } catch {
        resultLine.textContent = 'Error';
    }
}
// function factorial Value
function factorialValue(n) {
    let result = 1;
    for (let i = 2; i <= n; i++) result *= i;
    return result;
}
// function nCr
function nCr(n, r) {
    if (r > n || n < 0 || r < 0) return "Error";
    return factorialValue(n) / (factorialValue(r) * factorialValue(n - r));
}
// function nPr
function nPr(n, r) {
    if (r > n || n < 0 || r < 0) return "Error";
    return factorialValue(n) / factorialValue(n - r);
}
