        let expr = inputLine.value;

        expr = expr.replace(/×/g, '*').replace(/÷/g, '/').replace(/−/g, '-');
        expr = expr.replace(/\^/g, '**');

        const openParens = (expr.match(//g) || []).length;
        const closeParens = (expr.match(//g) || []).length;
        if (openParens > closeParens) {
            expr += ')'.repeat(openParens - closeParens);
        }
// ----- معالجة nCr و nPr -----
expr = expr.replace(/(\d+)\s*C\s*(\d+)/g, "nCr($1,$2)");
expr = expr.replace(/(\d+)\s*P\s*(\d+)/g, "nPr($1,$2)");
// تحويل √(n,x) إلى Math.pow(x, 1/n)
expr = expr.replace(/√\(\s*(\d+)\s*,\s*([\d\.]+)\s*\)/g, "Math.pow($2, 1/$1)");
        const result = eval(expr);

        if (result === undefined || Number.isNaN(result)) {
            resultLine.textContent = 'Error';
        } else {
            resultLine.textContent = result;
            history.push({ expression: inputLine.value, result });
            updateHistoryList();
        }
    } catch (e) {
        resultLine.textContent = 'Error in expression';
    }
}
// function clear display
function clearDisplay() {
    inputLine.value = '';
    resultLine.textContent = '';
    inputLine.focus();
}
// function delete Previous
function deletePrevious() {
    const pos = inputLine.selectionStart;
    if (pos === 0) {
        alert('Cursor at start, nothing to delete');
        return;
    }
    const before = inputLine.value.slice(0, pos - 1);
    const after = inputLine.value.slice(pos);
    inputLine.value = before + after;
    inputLine.selectionStart = inputLine.selectionEnd = pos - 1;
    inputLine.focus();
}
// function gcd(a, b)
function gcd(a, b) {
    if (!b) return a;
    return gcd(b, a % b);
}
// function convert To Fraction
function convertToFraction() {
    const resultElement = document.getElementById("resultLine");
    let value = resultElement.innerText || resultElement.textContent;

    if (!value) return; // لا شيء للتحويل

    let number = parseFloat(value);

    if (isNaN(number)) return;

    // إذا كان كسرًا بالفعل، أرجعيه للعدد العشري
    if (value.includes("/")) {
        try {
            const [num, den] = value.split("/");
            resultElement.innerText = (parseFloat(num) / parseFloat(den)).toString();
        } catch {
            return;
        }
        return;
    }

    // تحويل عدد عشري إلى كسر
    let decimal = number % 1;

    if (decimal === 0) return;  // ليس عدداً عشرياً

    let denominator = 1000000;
    let numerator = Math.round(number * denominator);

    // تبسيط الكسر
    const gcd = (a, b) => b === 0 ? a : gcd(b, a % b);

    let g = gcd(Math.abs(numerator), denominator);

    numerator /= g;
    denominator /= g;

    resultElement.innerText = `${numerator}/${denominator}`;
}

document.getElementById('fractionBtn').addEventListener('click', convertToFraction);

disableCalculator();
</script>
